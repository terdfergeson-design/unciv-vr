
# The Quest app: Godot's Android build template (Project > Install Android Build Template), the packed game data
# (tools/pack_android_data.gd) and the exported APK
client/android/
client/android_data.pack
build/

# Android signing keys: never in the repository, and back yours up elsewhere - every update of the Quest app has
# to be signed with the same key (client/.godot, where Godot keeps the editor's copy, is ignored already)
*.keystore
*.jks

# Windows temp copies of DLLs in use
~*.TMP

# Release notes are drafted locally and pasted into the GitHub release, not kept in the repo
release-notes/
