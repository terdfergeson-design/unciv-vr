.godot/
# The Godot editor keeps the export keystore's path, alias and password in .godot/export_credentials.cfg (ignored
# with the rest of .godot above); this catches it should a Godot version put it here instead. Never commit either.
# The keystore file itself belongs outside this repository; the root .gitignore covers *.keystore and *.jks.
export_credentials.cfg
# local developer overrides (see scripts/main.gd _parse_args)
override.cfg
*.png.tmp
screenshots/
logs/

# Python caches (tools/convert_gmod_map.py)
__pycache__/
*.pyc

# Source Engine / Garry's Mod maps and their pieces: other people's work, converted for your own use only
# (tools/convert_gmod_map.py puts its backgrounds in ~/.unciv-vr/Backgrounds, outside this repository)
*.bsp
*.gma
*.vtf
*.vmt
*.zip

# Backgrounds converted from other games' maps, should a copy land here by mistake
backgrounds/PeachsCastle/
backgrounds/Skatepark/
