	"name": "Wonders",
	"author": "Unciv VR",
	"description": "Unciv's wonders overview, by era: which are built, being built or still to build. Click a built one to look at it.",
	"shown": false,
	"size": [0.3, 0.8],
	"home": [1.05, 0.42, -0.55, -37],
	"icon": "other:Wonders",
	"title": "Wonders",
