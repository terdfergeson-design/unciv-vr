; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Unciv VR"
config/description="A VR tabletop frontend for Unciv, driven by the unciv-bridge headless engine."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor]

import/use_multiple_threads=false

[editor_plugins]

enabled=PackedStringArray("res://addons/unciv_bridge/plugin.cfg")

[gui]

theme/default_font_generate_mipmaps=true
theme/default_font="res://fonts/ui_font.tres"

[internationalization]

locale/translations=PackedStringArray("res://translations/de.po", "res://translations/ar.po", "res://translations/he.po", "res://translations/es.po", "res://translations/fr.po", "res://translations/it.po", "res://translations/pt_BR.po", "res://translations/sv.po", "res://translations/pt_PT.po", "res://translations/nl.po", "res://translations/pl.po", "res://translations/tr.po", "res://translations/id.po", "res://translations/ja.po", "res://translations/ru.po", "res://translations/uk.po", "res://translations/cs.po", "res://translations/hu.po", "res://translations/ro.po", "res://translations/hr.po", "res://translations/ca.po", "res://translations/gl.po", "res://translations/nb.po", "res://translations/eo.po", "res://translations/zh_CN.po", "res://translations/zh_TW.po", "res://translations/vi.po", "res://translations/tok.po", "res://translations/mt.po", "res://translations/ko.po", "res://translations/fil.po")

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[xr]

openxr/enabled=true
openxr/extensions/render_model=true
shaders/enabled=true
openxr/extensions/meta/render_model=true
openxr/extensions/meta/dynamic_resolution=false
