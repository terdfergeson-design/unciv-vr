msgstr "%d 左轉"

msgid "%d enemy targets in reach (red rings): click one to aim"
msgstr "%d 範圍內的敵方目標（紅環）：點擊其中一個進行瞄準"

msgid "Actions"
msgstr "行動"

msgid "Pillage"
msgstr "劫掠"

msgid "Sure? Click again"
msgstr "當然可以嗎？再次點擊"

msgid "click the red button again"
msgstr "再次點擊紅色按鈕"

msgid "Build here"
msgstr "在這裡建造"

