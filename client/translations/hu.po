msgid "Tutorials can be turned off in Settings > Gameplay. They're all in the Civilopedia too."
msgstr "Az oktatóanyagok a Beállítások > Játékmenet menüben kikapcsolhatók. Mindegyik megtalálható a Civilopédiában is."

msgid " (%d turns)"
msgstr " (%d kör)"

msgid "Choose a free great person"
msgstr "Válassz egy híres embert ajándékba"

msgid "You have %d free great people to pick."
msgstr "%d ingyenes nagyszerű embereket választhat."

msgid "Vote for world leader"
msgstr "Szavazz a világelsőre"

msgid "Choose who should become the world leader and win a Diplomatic Victory!"
msgstr "Válassz, ki legyen a világ vezetője, aki kiérdemli a diplomáciai győzelmet!"

msgid "Vote for %s"
msgstr "Szavazz a %s-ra"

msgid "Abstain"
msgstr "Tartózkodás"

msgid "Nothing being researched - pick a tech!"
msgstr "Semmit sem kutatnak – válassz egy technológiát!"

msgid "Researching %s"
msgstr "%s kutatása"

msgid "You have %d free technologies to pick - choose a highlighted one."
msgstr "A %d ingyenes technológiák közül választhat – válasszon egy kiemeltet."

msgid "Science %+d per turn. Picking a later tech queues its prerequisites."
msgstr "Tudomány %+d fordulónként. Egy későbbi technológia kiválasztása sorba állítja annak előfeltételeit."

msgid "%s turns"
msgstr "%s kör"

msgid "Pick up where you left off, or start a new game."
msgstr "Folytasd ott, ahol abbahagytad, vagy kezdj új játékot."

