msgstr "بناء %s"

msgid "%d turns left"
msgstr "الأدوار المتبقية: ⁦%d⁩"

msgid "%d enemy targets in reach (red rings): click one to aim"
msgstr "أهداف العدو ضمن المدى (حلقات حمراء): ⁦%d⁩. انقر أحدها للتصويب"

msgid "Actions"
msgstr "الإجراءات"

msgid "Pillage"
msgstr "نهب"

