msgstr "السكان: ⁦%d⁩"

msgid "Defense %d"
msgstr "الدفاع: ⁦%d⁩"

msgid "Health %d/%d"
msgstr "الصحة: ⁦%d/%d⁩"

msgid "%d idle citizens"
msgstr "السكان غير المعينين: ⁦%d⁩"

msgid "Puppet"
msgstr "تابعة"

msgid "Starving! %d turns"
msgstr "مجاعة! عدد الأدوار: ⁦%d⁩"

msgid "Grows in %d turns"
msgstr "الأدوار حتى النمو: ⁦%d⁩"

msgid "Food -> production"
msgstr "الغذاء إلى الإنتاج"

msgid "Not growing"
msgstr "لا تنمو"

msgid "Border in %d turns"
msgstr "الأدوار حتى توسع الحدود: ⁦%d⁩"

msgid "Borders stopped"
msgstr "توقف توسع الحدود"

msgid "City view  -  tiles, citizens, queue, buying"
msgstr "عرض المدينة — الخانات والسكان وقائمة البناء والشراء"

msgid "This city is being razed - it shrinks each turn until it's gone. Stop razing it in the city view."
msgstr "يجري هدم هذه المدينة؛ تتقلص كل دور حتى تزول. يمكنك إيقاف الهدم من عرض المدينة."

msgid "Producing"
msgstr "قيد الإنتاج"

msgid "Producing nothing - pick something below"
msgstr "لا إنتاج — اختر شيئًا أدناه"

msgid "Buildings"
msgstr "المباني"

msgid "Wonders"
msgstr "العجائب"

msgid "Other"
msgstr "أخرى"

