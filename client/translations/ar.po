msgstr "الشراء الآن مقابل ⁦%d⁩ ذهب (لديك ⁦%d⁩)"

msgid "Promote %s"
msgstr "ترقية %s"

msgid "XP %d/%d. Pick one promotion.%s"
msgstr "الخبرة ⁦%d/%d⁩. اختر ترقية واحدة.%s"

msgid "Has: %s"
msgstr "لديها: %s"

msgid "No promotion available right now."
msgstr "لا توجد ترقية متاحة الآن."

msgid "Tutorial"
msgstr "درس تعليمي"

msgid "%d of %d"
msgstr "⁦%d⁩ من ⁦%d⁩"

msgid "%d more messages after this one"
msgstr "الرسائل المتبقية بعد هذه: ⁦%d⁩"

msgid "%s gives:"
msgstr "%s يمنح:"

msgid "They"
msgstr "الطرف الآخر"

msgid "You give:"
msgstr "تمنح:"

msgid "%d votes  %s"
msgstr "عدد الأصوات: ⁦%d⁩  %s"

msgid "voted for %s"
