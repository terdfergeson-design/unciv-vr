msgstr "التالي"

msgid "Research"
msgstr "البحث"

msgid "Recenter table"
msgstr "إعادة توسيط الطاولة"

msgid "No unit selected"
msgstr "لم تُحدد وحدة"

msgid "Point at a unit or city to select it."
msgstr "أشر إلى وحدة أو مدينة لتحديدها."

msgid "Fortified"
msgstr "متحصنة"

msgid "Sleeping"
msgstr "نائمة"

msgid "Automated"
msgstr "آلية"

msgid "On its way"
msgstr "في الطريق"

msgid "Embarked"
msgstr "مبحرة"

