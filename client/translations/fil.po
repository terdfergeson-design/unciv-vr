msgid "Strength"
msgstr "Lakas"

#: action_menu:171,action_menu:415,overview_board:521
msgid "RangedStrength"
msgstr "Lakas ng pana"

#: action_menu:172
msgid "Range"
msgstr "Saklaw"

#: action_menu:173,overview_board:522
msgid "Movement"
msgstr "Paggalaw"

#: action_menu:176,city_boards:91,overview_board:543
msgid "Rename"
msgstr "Ipangalan"

#: action_menu:185,action_menu:295,keyboard:92,main:5127
msgid "Cancel"
msgstr "Kanselahin"

#: action_menu:188
msgid "Skipping this turn (Skip again to give it orders)."
msgstr "Lalaktawan ngayong tira (Laktawan ulit para bigyan ito ng utos)."

#: action_menu:193,overview_board:523
msgid "Health"
msgstr "Kalusugan"

#: action_menu:197,overview_board:523
msgid "XP"
msgstr "XP"

#: action_menu:199
msgid "Promote!  Choose a promotion"
msgstr "I-promote!  Pumili ng promosyon"

#: action_menu:200,action_menu:237,icons:58,icons:58,overview_board:566
msgid "Promote"
msgstr "Magpaunlad"

#: action_menu:225
msgid "Building %s"
msgstr "Itinatayo ang %s"

#: action_menu:225
msgid "%d turns left"
msgstr "%d tira ang natitira"

#: action_menu:229
msgid "%d enemy targets in reach (red rings): click one to aim"
msgstr "%d target ng kaaway na abot (pulang singsing): i-click ang isa para tumutok"

#: action_menu:239
msgid "Actions"
msgstr "Mga aksyon"

#: action_menu:254,icons:59,icons:59
msgid "Pillage"
msgstr "Dambungin"

#: action_menu:261
msgid "Sure? Click again"
msgstr "Sigurado ka? I-click ulit"

#: action_menu:283
msgid "click the red button again"
msgstr "i-click ulit ang pulang button"

#: action_menu:291
msgid "Build here"
msgstr "Itayo rito"

#: action_menu:296,icons:56,icons:58
msgid "Stop"
msgstr "Itigil"

#: action_menu:297,action_menu:428,action_menu:453,settings_board:286
msgid "%d turns"
msgstr "%d tira"

#: action_menu:358
msgid "Population %d"
msgstr "Populasyon %d"

#: action_menu:360,city_boards:202
msgid "Defense %d"
msgstr "Depensa %d"

#: action_menu:361,city_boards:201
msgid "Health %d/%d"
msgstr "Kalusugan %d/%d"

#: action_menu:363
msgid "%d idle citizens"
msgstr "%d idle na mamamayan"

#: action_menu:365,city_boards:204,overview_board:311
msgid "Puppet"
msgstr "Papet"

#: action_menu:387
msgid "Starving! %d turns"
msgstr "Nagugutom! %d tira"

#: action_menu:390
msgid "Grows in %d turns"
msgstr "Lalaki sa loob ng %d tira"

#: action_menu:392
msgid "Food -> production"
msgstr "Pagkain -> produksyon"

#: action_menu:394
msgid "Not growing"
msgstr "Hindi lumalaki"

#: action_menu:402
msgid "Border in %d turns"
msgstr "Hangganan sa loob ng %d tira"

#: action_menu:402
