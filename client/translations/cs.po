msgstr "Nastavení"

msgid "No ancient ruins"
msgstr "Žádné starověké ruiny"

msgid "No natural wonders"
msgstr "Žádné přírodní zázraky"

msgid "Bigger maps slide under the table: hold a grip and drag, or use the overview at the far edge."
msgstr "Větší mapy se zasouvají pod stůl: držte je a táhněte, nebo použijte přehled na vzdálenějším okraji."

msgid "Gods & Kings adds religion, espionage, more civilizations and more units and buildings."
msgstr "Gods & Kings přidává náboženství, špionáž, více civilizací a více jednotek a budov."

msgid "Difficulty"
msgstr "Obtížnost"

msgid "Game speed"
msgstr "Rychlost hry"

msgid "Starting era"
msgstr "Počáteční éra"

msgid "AI players"
msgstr "AI hráči"

msgid "City-states"
msgstr "Městské státy"

msgid "Victory types (none picked = all)"
