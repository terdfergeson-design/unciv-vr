msgstr "Chưa có điều kỳ diệu nào được thể hiện."

msgid "Every unit you have, the ones still waiting for orders first, with what each is doing. Click one to select it."
msgstr "Mọi đơn vị bạn có, những đơn vị vẫn đang chờ đơn hàng trước, với những gì mỗi đơn vị đang làm. Bấm vào một để chọn nó."

msgid "Every city you have, the capital first, with what each is building and how big it is. Click one to open its card."
msgstr "Mỗi thành phố bạn có, thủ đô đầu tiên, mỗi thành phố đang xây dựng những gì và nó lớn như thế nào. Bấm vào một cái để mở thẻ của nó."

msgid "Every military unit you have, with its action, moves and health. Click one to select it."
msgstr "Mỗi đơn vị quân đội bạn có, với hành động, bước di chuyển và sức khỏe của nó. Bấm vào một để chọn nó."

msgid "Rankings of all known civilizations by total score points."
msgstr "Xếp hạng của tất cả các nền văn minh được biết đến theo tổng điểm."

msgid "Unciv's wonders overview, by era: which are built, being built or still to build. Click a built one to look at it."
msgstr "Tổng quan về các kỳ quan của Unciv, theo thời đại: được xây dựng, đang được xây dựng hoặc vẫn đang xây dựng. Nhấp vào một cái được xây dựng để xem nó."

msgid "In the Hall of the Mountain King"
msgstr "Trong hội trường của Vua Núi"

msgid "The subterranean throne hall of the Troll King deep within the Dovre mountains, lit by fire braziers and glowing magma veins"
msgstr "Sảnh ngai dưới lòng đất của Vua Troll nằm sâu trong dãy núi Dovre, được thắp sáng bởi những lò lửa và những mạch magma rực sáng"

msgid "Mountains and clouds"
msgstr "Núi và mây"

msgid "A meadow ringed by low-poly peaks, with trees and drifting clouds"
msgstr "Một đồng cỏ được bao quanh bởi những đỉnh núi thấp, có cây cối và những đám mây trôi"

msgid "Floating in space"
msgstr "Bay lơ lửng trong không gian"

msgid "The table floats among the stars, by a ringed planet"
msgstr "Chiếc bàn lơ lửng giữa các vì sao, bởi một hành tinh có vành đai"

msgid "Studio"
msgstr "Studio"

msgid "A plain, dark room"
msgstr "Một căn phòng tối tăm, đơn điệu"

msgid "Webb Deep Field"
msgstr "Trường sâu Webb"

msgid "The table floats in deep space, surrounded by the James Webb Space Telescope's First Deep Field"
msgstr "Chiếc bàn lơ lửng trong không gian sâu thẳm, được bao quanh bởi Trường sâu đầu tiên của Kính viễn vọng Không gian James Webb"

msgid "Ornate oak"
msgstr "Cây sồi trang trí công phu"

msgid "Oak with walnut and holly stringing, a carved rope edge, and a pedestal on scroll feet"
msgstr "Gỗ sồi với dây gỗ óc chó và nhựa ruồi, mép dây chạm khắc và bệ đỡ trên chân cuộn"

msgid "Plain wood"
msgstr "Gỗ trơn"

msgid "A round dark wooden slab on a tapering column"
msgstr "Một tấm gỗ tròn màu sẫm đặt trên một cột thuôn nhọn"

msgid "Low poly"
msgstr "Poly thấp"

msgid "Faceted low-poly terrain, one flat colour per face"
msgstr "Địa hình low-poly nhiều mặt, một màu phẳng cho mỗi mặt"

