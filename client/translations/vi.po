msgid "Map replay"
msgstr "Phát lại bản đồ"

msgid "The map is zoomed out to show its full extent. Ownership and city locations update as the turns play."
msgstr "Bản đồ được thu nhỏ để hiển thị toàn bộ phạm vi của nó. Quyền sở hữu và vị trí thành phố cập nhật khi đến lượt chơi."

msgid "Start replay"
msgstr "Bắt đầu phát lại"

msgid "Return to game"
msgstr "Trở về trò chơi"

msgid "Turn %d of %d"
msgstr "Lượt %d trên %d"

msgid "Close replay"
msgstr "Đóng phát lại"

msgid "Turn %d / %d"
msgstr "Lượt %d / %d"

msgid "Saved on this PC between sessions"
msgstr "Đã lưu trên PC này giữa các phiên"

msgid "Move the table..."
msgstr "Di chuyển bàn..."

msgid "Back to the middle"
msgstr "Trở về giữa"

msgid "Your controllers"
msgstr "Bộ điều khiển của bạn"

msgid "Show button labels"
msgstr "Hiển thị nhãn nút"

msgid "Floating labels beside each controller saying what its buttons do right now."
msgstr "Các nhãn nổi bên cạnh mỗi bộ điều khiển cho biết các nút của nó hiện đang làm gì."

msgid "The right trigger clicks when you let go of it, so holding it to zoom doesn't click anything."
msgstr "Trình kích hoạt bên phải sẽ nhấp chuột khi bạn thả nó ra, vì vậy việc giữ nó để thu phóng sẽ không nhấp vào bất cứ thứ gì."

msgid "Look"
msgstr "Giao diện"

msgid "Gameplay"
msgstr "Lối chơi"

msgid "Automation"
msgstr "Tự động"

msgid "Sound"
msgstr "Âm thanh"

msgid "Panels"
msgstr "Bảng"

msgid "Controls"
msgstr "Điều khiển"

msgid "Game and saves"
msgstr "Trò chơi và bản lưu"

msgid "About"
msgstr "Giới thiệu"

msgid "Settings"
msgstr "Cài đặt"

msgid "Close"
msgstr "Đóng"

msgid "Around the table"
msgstr "Xung quanh bàn"

msgid "Backgrounds and tables are folders anyone can add: see backgrounds/README.md and tables/README.md."
msgstr "Hình nền và bảng là các thư mục mà bất kỳ ai cũng có thể thêm: xem backgrounds/README.md và tables/README.md."

msgid "Background"
msgstr "Nền"

msgid "The world around the table: sky, light and scenery."
msgstr "Thế giới xung quanh chiếc bàn: bầu trời, ánh sáng và phong cảnh."

msgid "Table"
msgstr "Bàn"

msgid "What the map lies on. In VR its column stretches to the height you set."
msgstr "Bản đồ nằm ở đâu. Trong VR, cột của nó trải dài đến độ cao bạn đặt."

msgid "Where the table stands"
msgstr "Cái bàn đứng ở đâu"

msgid "Move the table anywhere in the background's scenery - handy in big ones like a converted map. Remembered for this background."
msgstr "Di chuyển bảng đến bất kỳ vị trí nào trong khung cảnh nền - tiện dụng ở những bảng lớn như bản đồ được chuyển đổi. Ghi nhớ cho nền này."

msgid "Move the table anywhere in the background's scenery - handy in big ones like a converted map. It's been moved here; Back to the middle puts it where the background starts it."
msgstr "Di chuyển bảng đến bất kỳ vị trí nào trong khung cảnh nền - tiện dụng ở những bảng lớn như bản đồ được chuyển đổi. Nó đã được chuyển đến đây; Quay lại giữa đặt nó ở nơi nền bắt đầu."

msgid "Remembered for this background."
msgstr "Ghi nhớ cho nền này."

msgid "It's been moved here; Back to the middle puts it where the background starts it."
msgstr "Nó đã được chuyển đến đây; Quay lại giữa đặt nó ở nơi nền bắt đầu."

msgid "The map"
msgstr "Bản đồ"

msgid "Tiles"
msgstr "Ô"

msgid "How terrain, wonders, resources and improvements look. Tilesets work like Unciv's: see tilesets/README.md."
msgstr "Địa hình, kỳ quan, tài nguyên và cải tiến trông như thế nào. Các ô xếp hoạt động giống như của Unciv: xem tilesets/README.md."

msgid "Plain coloured hexes"
msgstr "Hình lục giác màu trơn"

msgid "Flat hexes in Unciv's terrain colours, no models."
msgstr "Các hình lục giác phẳng có màu địa hình của Unciv, không có mô hình."

msgid "Units"
msgstr "Đơn vị"

msgid "Same as the tiles"
msgstr "Tương tự như gạch"

msgid "The unit models that come with the tileset above (the tiles' fallback set fills any gaps)."
msgstr "Các mô hình đơn vị đi kèm với tập hợp ô ở trên (bộ dự phòng của ô sẽ lấp đầy mọi khoảng trống)."

msgid "No models"
msgstr "Không có mô hình"

msgid "Round tokens with Unciv's unit icons."
msgstr "Token tròn có biểu tượng đơn vị của Unciv."

msgid "How units look (Unciv's Unitset): any tileset with unit models (pieces/Units) can supply them."
msgstr "Các đơn vị trông như thế nào (Unciv's Unitset): bất kỳ tập hợp nào có mẫu đơn vị (pieces/Units) đều có thể cung cấp chúng."

msgid "Visual hints"
msgstr "Gợi ý trực quan"

msgid "Unciv's map overlays; the round buttons beside the overview turn them on and off too."
msgstr "Lớp phủ bản đồ của Unciv; các nút tròn bên cạnh phần tổng quan cũng bật và tắt chúng."

msgid "Show unit movement arrows"
msgstr "Hiển thị các mũi tên di chuyển đơn vị"

msgid "Where units have just moved and who attacked whom."
msgstr "Đơn vị vừa di chuyển đến đâu và ai tấn công ai."

msgid "Show tile yields"
msgstr "Hiển thị sản lượng ô"

msgid "Food, production, gold... on every tile."
msgstr "Thực phẩm, sản xuất, vàng... trên từng viên gạch."

msgid "Show worked tiles"
msgstr "Hiện ô đã chỉ định"

msgid "Which tiles your cities' citizens work."
msgstr "Những viên gạch mà công dân thành phố của bạn làm việc."

msgid "Show resources and improvements"
msgstr "Hiện các tài nguyên và cải tiến"

msgid "Resource and improvement symbols on the tiles."
msgstr "Các biểu tượng tài nguyên và cải tiến trên các ô xếp."

msgid "Show improvement pictures"
msgstr "Hiển thị hình ảnh cải tiến"

msgid "Farms, mines, roads and the like as models."
msgstr "Trang trại, hầm mỏ, đường sá và những thứ tương tự làm mô hình."

msgid "Show unit icons"
msgstr "Hiển thị biểu tượng đơn vị"

msgid "The small Unciv icon above each unit model."
msgstr "Biểu tượng Unciv nhỏ phía trên mỗi mẫu đơn vị."

msgid "Language"
msgstr "Ngôn ngữ"

msgid "Unciv's own translations, by Unciv's translators: the game's messages, names and descriptions. Our own menus are still in English."
msgstr "Bản dịch riêng của Unciv, do người dịch của Unciv thực hiện: thông điệp, tên và mô tả của trò chơi. Thực đơn riêng của chúng tôi vẫn bằng tiếng Anh."

msgid "Text Unciv has no translation for stays in English."
msgstr "Text Unciv không có bản dịch cho việc lưu trú bằng tiếng Anh."

msgid "Turns"
msgstr "Lượt"

msgid "Check for idle units"
msgstr "Kiểm tra các Đơn vị nhàn rỗi"

msgid "End turn first takes you to every unit that still has no orders."
msgstr "Lượt kết thúc đầu tiên sẽ đưa bạn đến từng đơn vị vẫn chưa có đơn hàng."

msgid "Auto unit cycle"
msgstr "Tự chuyển đơn vị"

msgid "After you give a unit its orders, the next unit waiting for orders is selected."
msgstr "Sau khi bạn ra lệnh cho một đơn vị, đơn vị tiếp theo đang chờ lệnh sẽ được chọn."

msgid "Cycle idle units by distance"
msgstr "Chuyển qua các đơn vị nhàn rỗi theo khoảng cách"

msgid "Next / previous unit go to the nearest unit rather than in a fixed order."
msgstr "Đơn vị tiếp theo/trước đi đến đơn vị gần nhất thay vì theo một thứ tự cố định."

msgid "Ask for confirmation when ending the turn"
msgstr "Yêu cầu xác nhận khi kết thúc lượt"

msgid "End turn needs a second press."
msgstr "Cuối lượt cần nhấn lần thứ hai."

msgid "Order trade offers by amount"
msgstr "Yêu cầu giao dịch theo số lượng"

msgid "On the trade table, the biggest offers come first."
msgstr "Trên bàn giao dịch, những lời đề nghị lớn nhất sẽ được ưu tiên trước."

msgid "Show suggested city locations"
msgstr "Hiển thị các vị trí thành phố được đề xuất"

msgid "With a settler selected, Unciv's three best spots nearby for a new city are marked on the map."
msgstr "Với một người định cư được chọn, ba địa điểm tốt nhất của Unciv gần thành phố mới sẽ được đánh dấu trên bản đồ."

msgid "Tutorials"
msgstr "Hướng dẫn"

msgid "Show tutorials"
msgstr "Hiện phần hướng dẫn"

msgid "The tutorial messages and the task card. Every tutorial is in the Civilopedia too."
msgstr "Các tin nhắn hướng dẫn và thẻ nhiệm vụ. Mọi hướng dẫn đều có trong Civilopedia."

msgid "Reset tutorials"
msgstr "Đặt lại hướng dẫn"

msgid "Show every tutorial and task again, as if you were new."
msgstr "Hiển thị lại mọi hướng dẫn và nhiệm vụ, như thể bạn là người mới."

msgid "Other players"
msgstr "Người chơi khác"

msgid "Other players' turns"
msgstr "Đến lượt người chơi khác"

msgid "What you see of the other players' turns after you end yours."
msgstr "Những gì bạn thấy về lượt của người chơi khác sau khi bạn kết thúc lượt của mình."

msgid "Show the moves and battles I can see"
msgstr "Hiển thị các bước di chuyển và trận chiến mà tôi có thể thấy"

msgid "Played back in order; the view glides to fights."
msgstr "Phát lại theo thứ tự; cái nhìn lướt qua để chiến đấu."

msgid "Show them, fast"
msgstr "Cho họ xem, nhanh lên"

msgid "The same, at two and a half times the speed."
msgstr "Tương tự, với tốc độ gấp hai lần rưỡi."

msgid "Don't show them"
msgstr "Đừng cho họ xem"

msgid "The map just updates."
msgstr "Bản đồ chỉ cập nhật."

msgid "Unciv's own options for automated units and cities."
msgstr "Các lựa chọn riêng của Unciv cho các đơn vị và thành phố tự động."

msgid "Automated and exploring units move"
msgstr "Các đơn vị tự động và khám phá di chuyển"

msgid "When units on automation, exploring or on multi-turn moves take their steps."
msgstr "Khi các đơn vị được tự động hóa, khám phá hoặc di chuyển nhiều lượt thực hiện các bước của mình."

msgid "When I end my turn"
msgstr "Khi tôi kết thúc lượt của mình"

msgid "Explorers, automated workers and units on long moves go as you end the turn."
msgstr "Người thám hiểm, công nhân tự động và các đơn vị di chuyển dài sẽ đi khi bạn kết thúc lượt."

msgid "At the start of my turn"
msgstr "Khi bắt đầu lượt của tôi"

msgid "They go as your turn starts (Unciv's \"Automated units move on turn start\")."
msgstr "Chúng đi khi lượt của bạn bắt đầu (\"Các đơn vị tự động di chuyển khi bắt đầu lượt\" của Unciv)."

msgid "Auto-assign city production"
msgstr "Tự động chỉ định sản xuất cho thành phố"

msgid "A city that finishes building something picks what to build next itself."
msgstr "Một thành phố hoàn thành việc xây dựng một cái gì đó sẽ tự chọn những gì sẽ xây dựng tiếp theo."

msgid "Auto-build roads"
msgstr "Tự động xây đường"

msgid "Automated workers build roads between your cities."
msgstr "Công nhân tự động xây dựng đường giữa các thành phố của bạn."

msgid "Automated workers replace improvements"
msgstr "Công nhân tự động thay thế cải tiến"

msgid "Automated workers may swap an improvement for a better one."
msgstr "Công nhân tự động có thể trao đổi một cải tiến để có một cải tiến tốt hơn."

msgid "Stop automated workers from removing vegetation"
msgstr "Ngăn chặn công nhân tự động loại bỏ thảm thực vật"

msgid "Automated workers leave forests, jungles and marshes alone."
msgstr "Công nhân tự động rời khỏi rừng, rừng rậm và đầm lầy một mình."

msgid "Automated units can upgrade"
msgstr "Các đơn vị tự động có thể nâng cấp"

msgid "Automated military units upgrade themselves when you can afford it."
msgstr "Các đơn vị quân đội tự động tự nâng cấp khi bạn có đủ khả năng."

msgid "Automated units choose promotions"
msgstr "Đơn vị tự động chọn thăng cấp"

msgid "Automated units pick their own promotions."
msgstr "Các đơn vị tự động chọn chương trình khuyến mãi của riêng họ."

msgid "Cities auto-bombard at end of turn"
msgstr "Các thành phố tự động bắn phá vào cuối lượt"

msgid "Cities that can still fire shoot at enemies in range when you end the turn."
msgstr "Các thành phố vẫn có thể bắn vào kẻ thù trong phạm vi khi bạn kết thúc lượt."

msgid "Auto-assign specialists in new cities"
msgstr "Tự động chỉ định chuyên gia tại các thành phố mới"

msgid "New cities put their citizens into specialist slots themselves."
msgstr "Các thành phố mới tự đưa công dân của mình vào các vị trí chuyên môn."

msgid "Sound effects"
msgstr "Hiệu ứng âm thanh"

msgid "Buttons, moves, battles and the rest. In VR they come from where they happen on the table."
msgstr "Các nút, di chuyển, trận chiến và phần còn lại. Trong VR, chúng đến từ nơi chúng xảy ra trên bàn."

msgid "City ambience"
msgstr "Không khí thành phố"

msgid "The city noise that loops while you are in a city - Unciv has one for every era."
msgstr "Tiếng ồn của thành phố vang lên khi bạn ở trong thành phố - Unciv có một tiếng ồn cho mọi thời đại."

msgid "Your own and mods'"
msgstr "Của riêng bạn và mod'"

msgid "None yet."
msgstr "Chưa có."

msgid "Put the panels back"
msgstr "Đặt các tấm trở lại"

msgid "Every panel goes back to where its panel.json puts it."
msgstr "Mọi bảng điều khiển sẽ quay trở lại vị trí panel.json của nó."

msgid "In VR you see the controllers you're holding, as your headset's runtime draws them (SteamVR does; others get a plain stand-in)."
msgstr "Trong VR, bạn sẽ thấy các bộ điều khiển bạn đang cầm khi thời gian chạy của tai nghe thu hút chúng (SteamVR có; các bộ điều khiển khác có chức năng thay thế đơn giản)."

msgid "Boards"
msgstr "bảng"

msgid "Put the boards back"
msgstr "Đặt các bảng trở lại"

msgid "The overview, info board, big screen, city boards, empire overview and this board go back where they started."
msgstr "Tổng quan, bảng thông tin, màn hình lớn, bảng thành phố, tổng quan về đế chế và bảng này quay trở lại nơi họ bắt đầu."

msgid "This game"
msgstr "Trò chơi này"

msgid "Save game"
msgstr "Lưu trò chơi"

msgid "Saves it under a name you type, in the bridge's save folder."
msgstr "Lưu nó dưới tên bạn nhập vào thư mục lưu của bridge."

msgid "Save..."
msgstr "Lưu..."

msgid "Main menu"
msgstr "Menu chính"

msgid "Back to the main menu; the game keeps running and Resume brings you back."
msgstr "Quay lại menu chính; trò chơi tiếp tục chạy và Tiếp tục sẽ đưa bạn trở lại."

msgid "Saves"
msgstr "Lưu"

msgid "Autosave"
msgstr "Tự động lưu"

msgid "How often the game saves itself as \"Autosave\" (Continue in the main menu loads it)."
msgstr "Tần suất trò chơi tự lưu dưới dạng \"Tự động lưu\" (Tiếp tục tải trò chơi trong menu chính)."

msgid "Save folder"
msgstr "Lưu thư mục"

msgid "A virtual-reality table for Unciv, the open-source remake of Civilization V."
msgstr "Một bảng thực tế ảo dành cho Unciv, phiên bản làm lại mã nguồn mở của Civilization V."

msgid "Bridge protocol"
msgstr "Giao thức cầu nối"

msgid "Mods"
msgstr "Mod"

msgid "Your own tilesets, backgrounds and tables"
msgstr "Các ô, hình nền và bảng của riêng bạn"

msgid "Put their folders here; they show up in Look."
msgstr "Đặt thư mục của họ ở đây; chúng xuất hiện trong Look."

msgid "Settings file"
msgstr "Tệp cài đặt"

msgid "Licence and credits"
msgstr "Giấy phép và tín dụng"

msgid "Desktop"
msgstr "Máy tính để bàn"

msgid "Off"
msgstr "Tắt"

msgid "On"
msgstr "Bật"

msgid "End turn"
msgstr "Kết thúc lượt"

msgid "< Prev"
msgstr "< Trước đó"

msgid "Idle unit"
msgstr "Đơn vị đang chờ"

msgid "Next >"
msgstr "Tiếp theo >"

msgid "Research"
msgstr "Nghiên cứu"

msgid "Recenter table"
msgstr "Bảng gần đây"

msgid "No unit selected"
msgstr "Không có đơn vị nào được chọn"

msgid "Point at a unit or city to select it."
msgstr "Chỉ vào một đơn vị hoặc thành phố để chọn nó."

msgid "Fortified"
msgstr "tăng cường"

msgid "Sleeping"
msgstr "đang ngủ"

msgid "Automated"
msgstr "tự động"

msgid "On its way"
msgstr "Trên đường đi"

msgid "Embarked"
msgstr "Xuống nước"

msgid "Strength"
msgstr "Sức mạnh"

msgid "RangedStrength"
msgstr "Sức mạnh tầm xa"

msgid "Range"
msgstr "Tầm xa"

msgid "Movement"
msgstr "Di chuyển"

msgid "Rename"
msgstr "Đổi tên"

msgid "Cancel"
msgstr "Hủy"

msgid "Skipping this turn (Skip again to give it orders)."
msgstr "Bỏ qua lượt này (Bỏ qua lần nữa để ra lệnh)."

msgid "Health"
msgstr "Máu"

msgid "XP"
msgstr "Điểm Kinh nghiệm"

msgid "Promote!  Choose a promotion"
msgstr "Quảng bá!  Chọn khuyến mãi"

msgid "Promote"
msgstr "Thăng cấp"

msgid "Building %s"
msgstr "Tòa nhà %s"

msgid "%d turns left"
msgstr "%d rẽ trái"

msgid "%d enemy targets in reach (red rings): click one to aim"
msgstr "%d mục tiêu của kẻ địch trong tầm tay (vòng màu đỏ): nhấp vào một mục tiêu để nhắm"

msgid "Actions"
msgstr "hành động"

msgid "Pillage"
msgstr "Cướp bóc"

msgid "Sure? Click again"
msgstr "Chắc chắn chứ? Bấm lại"

msgid "click the red button again"
msgstr "nhấp vào nút màu đỏ một lần nữa"

msgid "Build here"
msgstr "Xây dựng ở đây"

msgid "Stop"
msgstr "Dừng lại"

msgid "%d turns"
msgstr "%d lượt"

msgid "Population %d"
msgstr "Dân số %d"

msgid "Defense %d"
msgstr "Phòng thủ %d"

msgid "Health %d/%d"
msgstr "Sức khỏe %d/%d"

msgid "%d idle citizens"
msgstr "%d những công dân nhàn rỗi"

msgid "Puppet"
msgstr "Lập một Chính phủ Bù nhìn"

msgid "Starving! %d turns"
msgstr "Đói! %d lần lượt"

msgid "Grows in %d turns"
msgstr "Phát triển theo lượt %d"

msgid "Food -> production"
msgstr "Thực phẩm -> sản xuất"

msgid "Not growing"
msgstr "Không phát triển"

msgid "Border in %d turns"
msgstr "Đường viền ở lượt %d"

msgid "Borders stopped"
msgstr "Biên giới dừng lại"

msgid "City view  -  tiles, citizens, queue, buying"
