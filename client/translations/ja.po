msgstr "あなた"

msgid "World"
msgstr "世界"

msgid "Rules"
msgstr "ルール"

msgid "Random"
msgstr "ランダム"

msgid "%s  -  %s %s map, %s, %d AI, %d city-states"
msgstr "%s — %s %sマップ、%s、AI %d、都市国家 %d"

msgid "%s, led by %s"
msgstr "%s、指導者：%s"

msgid "Random: you'll find out who you are when the game starts."
msgstr "ランダム：ゲーム開始時に文明が決まります。"

msgid "Your civilization"
msgstr "自分の文明"

msgid "Map size"
msgstr "マップサイズ"

msgid "Map type"
msgstr "マップの種類"

msgid "Shape"
msgstr "形状"

msgid "Resources"
msgstr "資源"

msgid "Options"
msgstr "設定"

msgid "No ancient ruins"
msgstr "古代遺跡なし"

msgid "No natural wonders"
msgstr "自然遺産なし"

msgid "Bigger maps slide under the table: hold a grip and drag, or use the overview at the far edge."
msgstr "大きなマップはテーブルの下をスライドします。グリップを押してドラッグするか、奥側の概要を使ってください。"

msgid "Gods & Kings adds religion, espionage, more civilizations and more units and buildings."
msgstr "Gods & Kingsでは宗教、諜報活動、文明、ユニット、建造物が追加されます。"

msgid "Difficulty"
msgstr "難易度"

msgid "Game speed"
msgstr "ゲーム速度"

msgid "Starting era"
msgstr "開始時代"

msgid "AI players"
msgstr "AIプレイヤー"

msgid "City-states"
