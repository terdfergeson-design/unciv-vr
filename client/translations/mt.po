msgstr "Din il-logħba"

msgid "Save game"
msgstr "Issejvja l-logħba"

msgid "Saves it under a name you type, in the bridge's save folder."
msgstr "Issejvjah taħt isem li ttajpja, fil-folder tal-salvataġġ tal-pont."

msgid "Save..."
msgstr "Salv..."

msgid "Main menu"
msgstr "Menù Principali"

msgid "Back to the main menu; the game keeps running and Resume brings you back."
msgstr "Lura għall-menu prinċipali; il-logħba tibqa' taħdem u Resume ġġib lura."

msgid "Saves"
msgstr "Jiffranka"

msgid "Autosave"
msgstr "Salvataġġ awtomatiku"

msgid "How often the game saves itself as \"Autosave\" (Continue in the main menu loads it)."
msgstr "Kemm-il darba l-logħba ssalva lilha nnifisha bħala \"Autosave\" (Kompli fil-menu prinċipali tgħabbiha)."

msgid "Save folder"
msgstr "Ħlief folder"

msgid "A virtual-reality table for Unciv, the open-source remake of Civilization V."
msgstr "Tabella tar-realtà virtwali għal Unciv, ir-remake open-source ta’ Civilization V."

