msgid "%d idle citizens"
msgstr "Untätige Bürger: %d"

#: action_menu:365,city_boards:204,overview_board:311
msgid "Puppet"
msgstr "Marionette"

#: action_menu:387
msgid "Starving! %d turns"
msgstr "Hungersnot! %d Runden"

#: action_menu:390
msgid "Grows in %d turns"
msgstr "Wächst in %d Runden"

#: action_menu:392
msgid "Food -> production"
msgstr "Nahrung -> Produktion"

#: action_menu:394
msgid "Not growing"
msgstr "Kein Wachstum"

#: action_menu:402
msgid "Border in %d turns"
msgstr "Grenzerweiterung in %d Runden"

#: action_menu:402
msgid "Borders stopped"
msgstr "Keine Grenzerweiterung"

#: action_menu:407
msgid "City view  -  tiles, citizens, queue, buying"
msgstr "Stadtansicht – Felder, Bürger, Bauliste, Käufe"

#: action_menu:419
msgid "This city is being razed - it shrinks each turn until it's gone. Stop razing it in the city view."
msgstr "Diese Stadt wird niedergebrannt und schrumpft jede Runde, bis sie verschwunden ist. Du kannst dies in der Stadtansicht stoppen."

#: action_menu:423
msgid "Producing"
msgstr "Produziert"

#: action_menu:423
msgid "Producing nothing - pick something below"
msgstr "Keine Produktion – wähle unten etwas aus"

